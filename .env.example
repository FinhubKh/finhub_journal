# Copy to .env and fill in from Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# IMPORTANT: use "anon" / "public" key — NOT service_role
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never put this in the EA or frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# EA sync API (your own endpoint — not Supabase)
# Production URL shown on landing page and baked into EA config
VITE_EA_API_URL=https://finhubjournal.vercel.app/v1/ea/sync
EA_API_URL=https://finhubjournal.vercel.app/v1/ea/sync
# Local dev only: npm run api:dev (defaults to http://localhost:8787/v1/ea/sync)
# EA_API_PORT=8787

# After updating .env:
#   npm run db:check     — verify tables exist
#   npm run seed:admin   — create admin168@gmail.com (requires service role key)
#   npm run api:dev      — start EA sync API (local only)
#   npm run ea:config    — regenerate MT5 EA config
#
# SEA-LION AI (server-only — used by /v1/ai/checklist)
SEALION_API_KEY=your-sea-lion-api-key
# Optional model override (default: aisingapore/Qwen-SEA-LION-v4.5-27B-IT)
# SEALION_MODEL=aisingapore/Qwen-SEA-LION-v4.5-27B-IT

# Investor-password MT5 bridge (server-only)
# Generate both with: openssl rand -hex 32
INVESTOR_CRED_ENCRYPTION_KEY=your-64-char-hex-encryption-key
BRIDGE_SERVICE_TOKEN=your-64-char-hex-shared-bridge-token
# External Windows VPS MT5 bridge (investor-password sync)
MT5_BRIDGE_URL=https://your-bridge-host.example
# Optional: frontend → local API base for investor-credentials / investor-sync (and AI) in Vite dev
# VITE_AI_API_URL=http://localhost:8787

# Vercel deploy: also add INVESTOR_CRED_ENCRYPTION_KEY, BRIDGE_SERVICE_TOKEN,
# and MT5_BRIDGE_URL in Project Settings → Environment Variables.

# Vercel deploy: add env vars in Project Settings → Environment Variables:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SEALION_API_KEY
