# Copy to .env and fill in from Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# IMPORTANT: use "anon" / "public" key — NOT service_role
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never put this in the EA or frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# EA sync API (your own endpoint — not Supabase)
# Production URL shown on landing page and baked into EA config
VITE_EA_API_URL=https://finhubjournal.vercel.app/v1/ea/sync
EA_API_URL=https://finhubjournal.vercel.app/v1/ea/sync
# Local dev only: npm run api:dev (defaults to http://localhost:8787/v1/ea/sync)
# EA_API_PORT=8787

# After updating .env:
#   npm run db:check     — verify tables exist
#   npm run seed:admin   — create admin168@gmail.com (requires service role key)
#   npm run api:dev      — start EA sync API (local only)
#   npm run ea:config    — regenerate MT5 EA config
#
# Vercel deploy: add env vars in Project Settings → Environment Variables:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
